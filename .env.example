# Demo agent — set these in Vercel → Settings → Environment Variables.
# Never commit real values; this file is the template only.

# Required. The demo agent cannot run without it.
ANTHROPIC_API_KEY=

# Required for the HOT LEAD email. Without these the agent will tell the
# visitor honestly that the email could not be sent, which is what the
# prompt demands.
BREVO_API_KEY=
LEAD_EMAIL_FROM=            # a sender address Brevo has verified
LEAD_EMAIL_NAME=Conversing AI Demo
LEAD_EMAIL_BCC=             # optional: copy every demo lead to your inbox

# Optional tuning
AGENT_MODEL=claude-opus-5-5
AGENT_RATE_PER_MIN=10
