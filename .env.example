# Demo agent — set these in Vercel → Settings → Environment Variables.
# Never commit real values; this file is the template only.

# ─── Required. The demo agent cannot run without it. ───
ANTHROPIC_API_KEY=

# ─── Required for the HOT LEAD email, sent through your own cPanel mailbox.
# This route is already SPF- and DKIM-authenticated for conversingai.com,
# so it lands in inboxes rather than spam. Without these the agent tells the
# visitor honestly that the email could not be sent, which the prompt demands.
SMTP_HOST=premium59.web-hosting.com   # the server the TLS cert is valid for
SMTP_PORT=465                  # 465 implicit TLS, or 587 STARTTLS
SMTP_USER=                     # full mailbox address, e.g. demo@conversingai.com
SMTP_PASS=                     # that mailbox's password
LEAD_EMAIL_FROM=               # optional, defaults to SMTP_USER. Keep it on the same domain.
LEAD_EMAIL_NAME=Conversing AI Demo
LEAD_EMAIL_BCC=                # optional: copy every demo lead to your own inbox

# ─── Optional tuning ───
AGENT_MODEL=claude-opus-5-5
AGENT_RATE_PER_MIN=10

# ---------------------------------------------------------------- fallback
# Groq runs the demo when Anthropic fails in a way retrying will not fix:
# out of credit, bad key, no permission. Leave GROQ_API_KEY empty and there
# is no fallback - the visitor gets the contact form instead, which is the
# behaviour before this was added.
#   key:    https://console.groq.com/keys  (free tier available)
#   limits: https://console.groq.com/settings/limits
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile, the production Llama model
# that supports parallel tool calls.
# Set to "on" to let Groq answer when Anthropic fails unrecoverably.
# Off by default: see the note in api/chat.js before switching it on.
GROQ_FALLBACK=

GROQ_MODEL=
# Optional. Only for a regional or proxied endpoint; unset uses Groq default.
GROQ_BASE_URL=
